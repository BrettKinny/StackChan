--- a/src/esp/esp_tcp.cc
+++ b/src/esp/esp_tcp.cc
@@ -3,4 +3,5 @@
 #include <esp_log.h>
+#include <esp_heap_caps.h>
 #include <unistd.h>
 #include <cstring>
 #include <arpa/inet.h>
@@ -63,9 +64,24 @@
     xEventGroupClearBits(event_group_, ESP_TCP_EVENT_RECEIVE_TASK_EXIT);
-    xTaskCreate([](void* arg) {
+    receive_task_handle_ = nullptr;
+    const BaseType_t created = xTaskCreate([](void* arg) {
         EspTcp* tcp = (EspTcp*)arg;
         tcp->ReceiveTask();
         xEventGroupSetBits(tcp->event_group_, ESP_TCP_EVENT_RECEIVE_TASK_EXIT);
         vTaskDelete(NULL);
     }, "tcp_receive", 4096, this, 1, &receive_task_handle_);
+    if (created != pdPASS) {
+        last_error_ = ENOMEM;
+        ESP_LOGE(TAG, "TCP receive task allocation failed: free_internal=%u largest_internal=%u",
+                 static_cast<unsigned>(heap_caps_get_free_size(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT)),
+                 static_cast<unsigned>(heap_caps_get_largest_free_block(MALLOC_CAP_INTERNAL | MALLOC_CAP_8BIT)));
+        // No receiver exists: do not wait for its exit during teardown.
+        connected_ = false;
+        close(tcp_fd_);
+        tcp_fd_ = -1;
+        receive_task_handle_ = nullptr;
+        xEventGroupSetBits(event_group_, ESP_TCP_EVENT_RECEIVE_TASK_EXIT);
+        return false;
+    }
+    last_error_ = 0;
     return true;
 }
